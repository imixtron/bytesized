      "Bash(npm run:*)",
      "Bash(npm ci)",
      "Bash(npm --prefix engine run:*)",
      "Bash(npx remotion:*)",
      "Bash(npx tsc:*)",
      "Bash(npx tsx:*)",
      "Bash(cd:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(mkdir:*)",
      "Bash(git status:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push)",
      "Bash(git push origin main)",
      "Bash(git restore --staged:*)",
      "Bash(git rev-parse:*)",
      "Bash(git pull:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Edit(**)",
      "Write(episodes/**)",
