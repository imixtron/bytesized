# --- secrets (never commit) ---
.env
.env.*
!.env.example
*.pem
*.key

# --- dependencies & generated build output ---
node_modules/
engine/public/
engine/out/

# --- renders (regenerable from committed inputs via `npm run render:final`) ---
# storyboard/ and out/upload.md are committed: they're part of the episode recipe
episodes/*/out/*
!episodes/*/out/upload.md

# --- design-source files from third-party brand kits (engine uses derived/ PNGs) ---
assets/logos/**/*.eps
assets/logos/**/*.psd
assets/logos/**/*.zip

# --- local machine settings ---
.claude/settings.local.json
.DS_Store
*.log
