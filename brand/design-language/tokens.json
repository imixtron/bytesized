{
  "$version": "1.6.1",
  "$approved": "2026-10-06 (v1.6.1 focus fades + ghost slots requested by Imad after 003 draft review; v1.6 BigPicture + cover and v1.5 diagram templates approved 2026-10-06; v1.4 music 2026-10-01; v1.3 2026-09-29)",
  "$note": "Bytesized design language v1.6.1. Single source of truth for the video engine. Change only via a versioned update approved by Imad.",
  "canvas": {
    "width": 1080,
    "height": 1920,
    "fps": 30
  },
  "color": {
    "charcoal": "#222222",
    "surface": "#2C2B29",
    "line": "#45423D",
    "cream": "#F4F0E6",
    "cream2": "#B9B3A6",
    "cream3": "#77726A",
    "orange": "#C84A27",
    "ember": "#E8693F",
    "ok": "#7FB685",
    "warn": "#E9B44C",
    "down": "#E5484D"
  },
  "colorRoles": {
    "background": "charcoal",
    "text": "cream",
    "textSecondary": "cream2",
    "textDimmed": "cream3",
    "accentText": "ember",
    "accentShape": "orange",
    "request": "ember",
    "response": "cream",
    "wireIdle": "line",
    "wireLive": "cream3",
    "stingBackground": "orange"
  },
  "font": {
    "display": {
      "family": "Unbounded",
      "weight": 800
    },
    "text": {
      "family": "Inter",
      "weight": 800
    },
    "mono": {
      "family": "JetBrains Mono",
      "weight": 700
    },
    "script": {
      "family": "Yellowtail",
      "weight": 400
    }
  },
  "type": {
    "headline": {
      "font": "display",
      "size": 88,
      "lineHeight": 1.04,
      "maxWords": 5,
      "maxLines": 2,
      "accentWords": 1
    },
    "caption": {
      "font": "text",
      "size": 64,
      "lineHeight": 1.18,
      "maxLines": 2,
      "chunkWords": [
        3,
        5
      ]
    },
    "label": {
      "font": "mono",
      "size": 34,
      "case": "lower"
    },
    "cardTitle": {
      "font": "display",
      "size": 58
    },
    "cardSub": {
      "font": "text",
      "weight": 700,
      "size": 38
    },
    "accent": {
      "font": "script",
      "size": 120,
      "maxPerVideo": 1
    },
    "minSize": 32
  },
  "layout": {
    "safe": {
      "left": 64,
      "right": 930,
      "top": 250,
      "bottom": 1470
    },
    "progressBar": {
      "x": 64,
      "y": 48,
      "width": 866,
      "height": 10,
      "radius": 5
    },
    "cornerMark": {
      "x": 64,
      "y": 80,
      "size": 84,
      "asset": "brand/bytesized/svg/bytesized-mark-on-charcoal.svg"
    },
    "zones": {
      "headline": {
        "y": [
          200,
          400
        ]
      },
      "stage": {
        "y": [
          440,
          1370
        ]
      },
      "caption": {
        "y": [
          1420,
          1590
        ]
      }
    },
    "flowDirection": "top-to-bottom",
    "headlineRules": {
      "mostScenes": true,
      "minScenesWithout": 1,
      "maxInARow": 3,
      "skipOn": [
        "FlowDiagram-full",
        "GistCard",
        "Outro"
      ]
    },
    "$note": "v1.2: the progress bar and mark sit at the very top (they may be hidden under platform UI, which is accepted). The headline sits under them, the stage is larger and its content is centred vertically, and captions sit lower. Horizontal safe area unchanged.",
    "stageContent": {
      "align": "center",
      "maxGap": 110
    }
  },
  "node": {
    "stroke": 6,
    "radius": 30,
    "shadow": {
      "type": "hatch",
      "offset": 16,
      "angle": -33,
      "line": 4,
      "gap": 8,
      "opacity": 0.42
    },
    "iconScale": 0.58,
    "families": {
      "outlined": {
        "meaning": "inside our system",
        "fill": "surface",
        "stroke": "cream",
        "icon": "cream",
        "statesAllowed": true
      },
      "solid": {
        "meaning": "outside our system (users, 3rd-party, internet)",
        "fill": "cream",
        "stroke": "cream",
        "icon": "charcoal",
        "statesAllowed": false
      },
      "hero": {
        "meaning": "the episode's topic",
        "fill": "orange",
        "stroke": "orange",
        "icon": "cream",
        "statesAllowed": false,
        "maxOnScreen": 1
      },
      "brand": {
        "meaning": "third-party logo (reference only)",
        "fill": "cream",
        "stroke": "cream",
        "logo": "unaltered",
        "padding": [
          34,
          58
        ],
        "heroRing": {
          "color": "orange",
          "gap": 10,
          "width": 8
        },
        "statesAllowed": false,
        "onlyIn": "diagrams"
      }
    },
    "states": {
      "idle": {
        "stroke": "cream"
      },
      "active": {
        "stroke": "orange",
        "icon": "ember"
      },
      "overloaded": {
        "stroke": "warn",
        "icon": "warn",
        "badge": "!"
      },
      "down": {
        "stroke": "down",
        "icon": "down",
        "badge": "✕"
      },
      "recovered": {
        "stroke": "ok",
        "icon": "ok",
        "badge": "✓"
      },
      "dimmed": {
        "stroke": "cream3",
        "icon": "cream3",
        "shadowOpacity": 0.3
      }
    },
    "badge": {
      "size": 60,
      "offset": -26
    }
  },
  "wire": {
    "stroke": 6,
    "cap": "round"
  },
  "packet": {
    "size": 26,
    "glow": 30,
    "speedPxPerSec": 700
  },
  "icons": {
    "grid": 24,
    "stroke": 2,
    "cap": "round",
    "set": [
      "server",
      "db",
      "lb",
      "phone",
      "cache",
      "queue",
      "city",
      "box",
      "cop",
      "scale",
      "pulse",
      "gauge"
    ]
  },
  "motion": {
    "pop": {
      "ms": 400,
      "frames": 12,
      "easing": [
        0.34,
        1.56,
        0.64,
        1
      ],
      "spring": {
        "damping": 12,
        "stiffness": 180
      }
    },
    "standard": {
      "ms": 300,
      "frames": 9,
      "easing": [
        0.2,
        0.8,
        0.2,
        1
      ]
    },
    "focusFade": "v1.6.1: focus changes (highlight / dim / the newest card) ease over `standard` instead of switching in one frame",
    "ghost": {
      "opacity": 0.9,
      "$note": "v1.6.1: reveal templates draw faint dashed slots (line colour) from the scene start; each item pops in over its slot"
    },
    "exit": {
      "ms": 200,
      "frames": 6,
      "easing": [
        0.4,
        0,
        1,
        1
      ]
    },
    "stagger": {
      "ms": 100,
      "frames": 3
    },
    "shake": {
      "ms": 300,
      "frames": 9,
      "amplitude": 6
    },
    "biteWipe": {
      "ms": 300,
      "frames": 9,
      "use": "branding sting only"
    },
    "beatEverySec": [
      1.5,
      2.0
    ],
    "sceneChange": [
      "cut",
      "push"
    ],
    "progressBar": "linear over full video"
  },
  "brandSting": {
    "placement": "after hook",
    "durationSec": 1.5,
    "maxSec": 2,
    "frames": 45,
    "background": "orange",
    "vo": false,
    "sfx": "chomp",
    "bytesizedLogo": "brand/bytesized/svg/bytesized-logo-on-orange.svg",
    "parentLogo": "brand/back-in-a-gist/back-in-a-gist-on-orange.svg",
    "byline": "a segment by",
    "timeline": [
      {
        "frames": [
          0,
          9
        ],
        "do": "biteWipeIn"
      },
      {
        "frames": [
          9,
          21
        ],
        "do": "logosIn",
        "stagger": 3
      },
      {
        "frames": [
          21,
          39
        ],
        "do": "hold"
      },
      {
        "frames": [
          39,
          45
        ],
        "do": "exit",
        "scale": 0.96
      }
    ],
    "hide": [
      "cornerMark",
      "progressBar"
    ]
  },
  "ending": {
    "endsOn": "GistCard",
    "loopToHook": true,
    "cta": "spoken in gist vo"
  },
  "partTag": {
    "x": 170,
    "y": 100,
    "height": 44,
    "font": "mono",
    "size": 26,
    "stroke": 4,
    "strokeColor": "cream3",
    "text": "cream2",
    "digit": "ember",
    "format": "PART {part}/{of}"
  },
  "audio": {
    "$note": "v1.3: sounds and music come from the audio library (assets/sfx/library.json, assets/music/library.json), generated once and reused. Scripts never list sounds: the map below picks them from what happens on screen, and a beat may override with `sfx:`. v1.4: music is one of the four sibling theme tracks in `roster`, picked at random per episode by `npm run music:assign` (episodes/music.json) and stored in the episode's music.track. `theme` is the default when an episode has no pick.",
    "music": {
      "theme": "bytesized-theme",
      "roster": [
        "bytesized-theme",
        "bytesized-theme-2",
        "bytesized-theme-3",
        "bytesized-theme-4"
      ],
      "rotation": "episodes/music.json",
      "fallbacks": [
        "placeholder-playful-loop"
      ],
      "volume": 0.14,
      "duckTo": 0.45,
      "duckRampFrames": 8,
      "fadeInSec": 0.4,
      "fadeOutSec": 0.8
    },
    "voice": {
      "volume": 1.0
    },
    "map": {
      "sting": "chomp",
      "appear": "pop",
      "reveal": "pop",
      "flood": "whoosh",
      "push": "whoosh",
      "state:overloaded": "warning",
      "state:down": "error",
      "state:recovered": "success",
      "count": "tick",
      "zoom": "swoosh-up",
      "step": "pop",
      "branch": "pop",
      "race": "whoosh"
    },
    "levels": {
      "chomp": 0.8,
      "pop": 0.2,
      "whoosh": 0.28,
      "warning": 0.35,
      "error": 0.4,
      "success": 0.35,
      "tick": 0.22,
      "swoosh-up": 0.28,
      "default": 0.3
    },
    "minGapFrames": 6
  },
  "diagram": {
    "$note": "v1.5: every diagram template draws into a panel (local coordinates, sized to the stage) so a later BigPicture beat can tile them. Inside Split halves and Sequence messages, flows run left → right; everything else stays top → bottom.",
    "panel": {
      "pad": 20
    },
    "lane": {
      "node": 140,
      "lifeline": 4,
      "dash": [
        10,
        16
      ]
    },
    "step": {
      "badge": 56,
      "stroke": 6,
      "head": 22,
      "maxSteps": 7,
      "drawFrames": 12
    },
    "note": {
      "radius": 22,
      "stroke": 4,
      "pad": [
        14,
        22
      ]
    },
    "diamond": {
      "w": 420,
      "h": 180,
      "textWidth": 250,
      "textSize": 34
    },
    "outcome": {
      "node": 130
    },
    "tier": {
      "h": 150,
      "gap": 26,
      "axisWidth": 120,
      "pyramidTop": 0.5
    },
    "split": {
      "gap": 44,
      "node": 140,
      "chip": {
        "size": 30,
        "height": 52
      }
    },
    "lit": {
      "stroke": "orange"
    }
  },
  "bigPicture": {
    "$note": "v1.6: optional pull-back beat before the gist. Earlier scenes' diagrams, frozen on their last frame, tiled 2 across; the camera starts inside panel 1 and pulls back.",
    "gap": 28,
    "rowGap": 76,
    "radius": 26,
    "border": 4,
    "pullFrames": 24,
    "pullDelay": 4,
    "stagger": 4,
    "dim": 0.38,
    "maxPanels": 4
  },
  "cover": {
    "$note": "v1.6: 1080×1920 cover / thumbnail per episode: title on charcoal + up to 4 diagram panels. Corner mark only; no sting logos.",
    "titleSize": 104,
    "titleY": 200,
    "gridTop": 560,
    "gridBottom": 1640,
    "maxPanels": 4
  }
}
